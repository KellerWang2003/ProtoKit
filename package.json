{
  "name": "proto-kit",
  "version": "0.1.0",
  "description": "Drop-in device frames and a DialKit debug panel for React prototypes.",
  "type": "module",
  "license": "MIT",
  "author": "Keller Wang",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "vite demo",
    "demo:build": "vite build demo",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "watch": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KellerWang2003/protokit.git"
  },
  "homepage": "https://github.com/KellerWang2003/protokit#readme",
  "dependencies": {
    "dialkit": "^2.1.0",
    "motion": "^14.10.1"
  }
}
